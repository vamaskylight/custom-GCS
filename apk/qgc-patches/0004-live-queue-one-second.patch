             break;
         }
 
-        // leaky=downstream (2) + tiny depth: the live-display branch must drop the oldest
-        // buffer on backpressure, not stall the streaming thread. Recording branch (below)
-        // keeps default non-leaky semantics so every frame reaches the muxer.
+        // leaky=downstream (2): the live-display branch must drop the oldest buffer on
+        // backpressure, not stall the streaming thread. Recording branch (below) keeps
+        // default non-leaky semantics so every frame reaches the muxer.
+        // VAMA patch (apk/qgc-patches/0004): one second deep, not two buffers. What this queue
+        // drops is coded video, and the decoder then shows grey, smeared blocks until the next
+        // keyframe. Two buffers are one frame on a tee that carries NAL units (AUD and slice), so
+        // a thread one frame late lost a frame. The SIYI RC's live picture broke while the camera
+        // turned, and its recording from the branch below was whole (test build 15, 2026-10-28).
+        // The queue holds data only while its thread is behind, so it adds no delay otherwise.
         g_object_set(decoderQueue,
                      "leaky", 2,
-                     "max-size-buffers", 2,
-                     "max-size-bytes", 0,
-                     "max-size-time", G_GUINT64_CONSTANT(0),
+                     "max-size-buffers", 0,
+                     "max-size-bytes", 10 * 1024 * 1024,
+                     "max-size-time", G_GUINT64_CONSTANT(1000000000),
                      nullptr);
 
         _decoderValve = gst_element_factory_make("valve", nullptr);
