+        // keyframe. On a tee of NAL units two buffers are one frame (AUD and slice). The SIYI RC's
+        // live picture broke while the camera turned, and its recording from the branch below was
+        // whole (test build 15, 2026-10-28). Desktop GStreamer 1.24, a SIYI-like stream, this
+        // thread 40 to 70 ms late now and then: two buffers dropped 28 and left 14.5 s of 25 s
+        // corrupted, one second dropped nothing, with the same delay. The queue holds data only
+        // while its thread is behind.
         g_object_set(decoderQueue,
                      "leaky", 2,
-                     "max-size-buffers", 2,
-                     "max-size-bytes", 0,
-                     "max-size-time", G_GUINT64_CONSTANT(0),
+                     "max-size-buffers", 0,
+                     "max-size-bytes", 10 * 1024 * 1024,
